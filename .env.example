# ── 데이터베이스 ────────────────────────────────────────────────────────
# Vercel Postgres / Neon 을 쓸 때는 풀러(-pooler) 엔드포인트를 권합니다.
# 서버리스는 인스턴스가 자주 뜨고 지므로 직결 엔드포인트는 커넥션을 금방 소진합니다.
DATABASE_URL=postgres://postgres@127.0.0.1:5433/gong

# ── 메일링: 회사 메일 한 개 ──────────────────────────────────────────────
# 발송·수신 모두 이 주소 하나로 처리합니다. 담당자별 주소를 만들지 않습니다.
# Reply-To 에 partner+cm_{token}@ 플러스 주소를 넣어 회신을 자동 매핑합니다.
MAIL_BASE_ADDRESS=partner@dinostudio.kr
MAIL_ORG_NAME=Dinostudio (주)
MAIL_POSTAL=서울시 성동구 …
MAIL_PHONE=02-000-0000
UNSUB_BASE_URL=https://example.vercel.app/u

# ── 커넥션 풀 ───────────────────────────────────────────────────────────
# 서버리스에서는 인스턴스당 커넥션을 작게 잡습니다.
PGPOOL_MAX=5

# ── 테스트 전용 (로컬) ──────────────────────────────────────────────────
TEST_PG_ADMIN=postgres://postgres@127.0.0.1:5433/postgres
TEST_DATABASE_URL=postgres://postgres@127.0.0.1:5433/gong_test
E2E_DATABASE_URL=postgres://postgres@127.0.0.1:5433/gong_e2e
